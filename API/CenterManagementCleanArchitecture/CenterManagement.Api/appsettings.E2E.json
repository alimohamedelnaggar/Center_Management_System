{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CenterManagement_E2E;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "jwtSettings": {
    "secret": "E2E-Only-CenterManagement-Secret-Key-2026-Never-Use-In-Production",
    "issuer": "CenterManagement",
    "audience": "WebSite",
    "validateAudience": true,
    "validateIssuer": true,
    "validateLifetime": true,
    "validateIssuerSigningKey": true,
    "AccessTokenExpireDate": 1,
    "RefreshTokenExpireDate": 20
  },
  "emailSettings": {
    "port": "2525",
    "host": "localhost",
    "FromEmail": "e2e@example.test",
    "password": "not-a-real-password"
  },
  "Seed": {
    "E2EEnabled": true,
    "E2EReset": false,
    "E2EPassword": "E2e!Pass#2026",
    "E2EStudentPassword": "Student!2026"
  },
  "RateLimiting": {
    "SignIn": {
      "Enabled": false,
      "IpPermitLimit": 1000,
      "UserPermitLimit": 1000,
      "WindowSeconds": 60
    }
  },
  "ExamReminder": {
    "CheckMinutes": 5,
    "LeadMinutes": 60
  }
}
